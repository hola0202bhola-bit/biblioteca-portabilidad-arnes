{
  "name": "biblioteca-portabilidad-arnes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/composition/server.js",
    "test": "node --test --test-reporter=tap --experimental-test-coverage --test-coverage-include=dist/src/** --test-coverage-exclude=dist/src/composition/server.js --test-coverage-lines=95 --test-coverage-functions=95 --test-coverage-branches=90 tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo:portabilidad": "node scripts/demonstrate.mjs"
  },
  "dependencies": {
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.74.0",
    "typescript": "5.9.3"
  }
}
